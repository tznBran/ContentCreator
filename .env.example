# Copy to .env at the repo root and fill in.
# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000

# Database (matches infra/docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://contentcreator:contentcreator@localhost:5432/contentcreator

# Redis (job queue, cache)
REDIS_URL=redis://localhost:6379/0

# Set to false in tests / dry-run mode to skip enqueueing RQ tasks
ENQUEUE_JOBS=true

# Object storage (MinIO local; swap for S3/R2 in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=contentcreator
S3_SECRET_KEY=contentcreator
S3_BUCKET=contentcreator
S3_PUBLIC_URL=http://localhost:9000/contentcreator

# OpenRouter (Phase 1+)
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_LLM_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_VISION_MODEL=anthropic/claude-3.5-sonnet

# TTS / voice cloning (Phase 3)
# tts_provider: "f5tts" (self-host) | "elevenlabs" | "replicate"
TTS_PROVIDER=f5tts
F5TTS_DEVICE=cuda
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# Social publishing (Phase 4)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Frontend (apps/web/.env.local will read this)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
